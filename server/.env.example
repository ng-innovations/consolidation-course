# --- Required ---

AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Full URL of /auth/callback as registered on the App Registration
# e.g. https://consolidation-course.up.railway.app/auth/callback
REDIRECT_URI=

# Generate with: openssl rand -hex 32
SESSION_SECRET=

# --- Course-specific values ---

# Serve the course content from the repo root (one level up from this server/)
STATIC_DIR=..

SITE_TITLE=Consolidation Course

# Path prefixes to 404 even though they exist on disk in the repo root.
# Hides internal/non-public files so they aren't accidentally served.
PATH_DENY=/server,/design,/pocs,/claude.md,/CLAUDE.md,/STYLE_NOTES.md,/readme.md,/README.md,/railway.toml,/package.json,/package-lock.json

# Restrict to Netgain emails (optional — empty means anyone in the tenant)
ALLOWED_EMAIL_DOMAINS=netgain.tech

# --- Optional ---

# Local dev: skip auth entirely
DEV_BYPASS=false

# Railway sets PORT automatically
PORT=3000
